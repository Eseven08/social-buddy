# ---- social-buddy configuration -------------------------------------------
# Copy this file to config.env and fill in what you need.
# Every variable is optional; defaults are shown after the =.

# --- backend (pick one) -----------------------------------------------------
# 1) OpenAI-compatible API (OpenAI, DeepSeek, Moonshot, local vLLM, ...)
# SOCIAL_BUDDY_BRAIN=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# SOCIAL_BUDDY_MODEL=gpt-4o-mini
#
# 2) Local model via Ollama (free, offline):
#     ollama pull qwen2.5:3b
# SOCIAL_BUDDY_BRAIN=ollama
# OLLAMA_HOST=http://localhost:11434
# SOCIAL_BUDDY_MODEL=qwen2.5:3b
#
# If neither key nor host is set, the retrieval fallback brain is used
# (no network, low quality -- enough for tests and the simulate demo).

# --- identity & basic info --------------------------------------------------
# SOCIAL_BUDDY_NAME=Buddy
# SOCIAL_BUDDY_PROFILE=profile.json   # persona + seed_facts (basic info)

# --- memory ------------------------------------------------------------------
# SOCIAL_BUDDY_STORE_DIR=.            # where buddy_memory_<conv>.json live
# SOCIAL_BUDDY_FOLLOW_UP_S=300        # how soon an open topic may be followed up

# --- QQ (OneBot v11) adapter -------------------------------------------------
# The bot logs into QQ with YOUR account through the bridge, so it can sit
# inside your group chats and DM your friends.
# SOCIAL_BUDDY_ONE_BOT_HTTP=http://127.0.0.1:3000
# SOCIAL_BUDDY_QQ_SELF=123456789      # the bot's own QQ (to ignore itself)
# SOCIAL_BUDDY_QQ_TARGET=987654321    # optional: a friend's QQ to DM
# SOCIAL_BUDDY_QQ_WHITELIST=          # optional: comma-separated QQs always answered
# SOCIAL_BUDDY_QQ_GROUP=              # optional: comma-separated group ids to join
# SOCIAL_BUDDY_WEBHOOK_PORT=8765
# SOCIAL_BUDDY_TICK_SECONDS=60        # proactive check interval
# SOCIAL_BUDDY_GROUP_REPLY_PROB=0.2   # join group chat probability (non-mention)
